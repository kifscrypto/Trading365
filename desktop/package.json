{
  "name": "t365-desk",
  "version": "1.2.1",
  "private": true,
  "description": "T365 Terminal - the local-first crypto terminal you own",
  "main": "dist/main/main.js",
  "author": "Trading365",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "dist:dir": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
