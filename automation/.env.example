# Trading365 admin
ADMIN_PASSWORD=
BASE_URL=https://trading365.org

# Google Search Console service account
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# X (Twitter) OAuth1 user context
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Gmail OAuth (KIFS) — path to the OAuth client secret JSON
KIFS_GMAIL_CLIENT_SECRET=automation/client_secret.json

# Optional overrides
# OPS_API_PORT=4173
# DATA_DIR=automation/data
